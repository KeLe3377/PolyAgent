# App
APP_NAME=polyagent
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# LLM: any OpenAI-compatible provider
LLM_API_KEY=replace-with-your-llm-key
LLM_BASE_URL=https://provider.example/v1
LLM_MODEL=replace-with-chat-model

# Embedding: may use the same or a different OpenAI-compatible provider
EMBED_API_KEY=replace-with-your-embedding-key
EMBED_BASE_URL=https://provider.example/v1
EMBED_MODEL=replace-with-embedding-model

# Optional retrieval reranker
RERANK_ENABLED=false
RERANK_PROVIDER=sentence_transformers
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_TOP_N=50
RERANK_TOP_K=5

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_COLLECTION_NAME=agent_knowledge

# Logging
LOG_LEVEL=INFO
